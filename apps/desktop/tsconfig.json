{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@packages/types": ["../../packages/types/src/index.ts"],
      "@packages/types/*": ["../../packages/types/src/*"],
      "@packages/shared": ["../../packages/shared/src/index.ts"],
      "@packages/shared/*": ["../../packages/shared/src/*"],
      "@packages/printing": ["../../packages/printing/src/index.ts"],
      "@packages/printing/*": ["../../packages/printing/src/*"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
