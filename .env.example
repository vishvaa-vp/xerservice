# XerService environment template
# Copy to .env.local for the root app. Copy the relevant public variables to
# apps/user/.env.local, apps/admin/.env.local, and apps/vendor/.env.local.
# Never commit populated environment files.

# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_PHONE_AUTH_ENABLED=true

# Server-only Supabase configuration (bypasses RLS)
SUPABASE_SECRET_KEY=your-service-role-secret
# Legacy alias accepted by some server modules:
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=

# Server/API routing
BACKEND_API_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
ENABLE_HSTS=false

# Razorpay: only NEXT_PUBLIC_RAZORPAY_KEY_ID is safe in browser bundles
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-server-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Phone OTP is delivered by the provider configured in Supabase Auth
PHONE_AUTH_ENABLED=true
OTP_PROVIDER=disabled
EXTERNAL_NOTIFICATIONS_ENABLED=false
SMS_PROVIDER=disabled
EMAIL_PROVIDER=disabled
WHATSAPP_PROVIDER=disabled

# Optional MSG91 provider (only when explicitly enabled)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# WhatsApp Cloud API
WHATSAPP_BUSINESS_PHONE=country-code-and-number
NEXT_PUBLIC_WHATSAPP_BUSINESS_PHONE=country-code-and-number
WHATSAPP_VERIFY_TOKEN=generate-a-long-random-value
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_MEDIA_DOWNLOAD_ENABLED=false
# META_APP_SECRET is used to verify webhook signatures. The two WHATSAPP
# variables are accepted only as legacy server-side aliases.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_SECRET=

# Meta Embedded Signup / WhatsApp Business App coexistence
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
WHATSAPP_COEXISTENCE_DEV_PAGE_ENABLED=false
NEXT_PUBLIC_META_APP_ID=
META_APP_ID=
META_APP_SECRET=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=
META_EMBEDDED_SIGNUP_REDIRECT_URI=

# Local automated fixtures only. Never enable in production.
WHATSAPP_TEST_MEDIA_PAYLOADS_ENABLED=false

# Desktop Vite build (place in apps/desktop/.env.local)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_BACKEND_URL=http://localhost:3000
# Rust/Tauri compile-time backend override:
XERSERVICE_BACKEND_URL=http://localhost:3000
