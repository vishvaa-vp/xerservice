{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@packages/types": ["../types/src/index.ts"],
      "@packages/types/*": ["../types/src/*"],
      "@packages/shared": ["../shared/src/index.ts"],
      "@packages/shared/*": ["../shared/src/*"],
      "@packages/backend": ["./src/index.ts"],
      "@packages/backend/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
