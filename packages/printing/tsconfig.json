{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["es2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@packages/types": ["../types/src/index.ts"],
      "@packages/types/*": ["../types/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
