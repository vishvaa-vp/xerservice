{
  "name": "xerservice",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "predev": "node scripts/prepare-pdfjs.cjs",
    "prebuild": "node scripts/prepare-pdfjs.cjs",
    "dev": "next dev",
    "build": "next build",
    "build:desktop": "pnpm --filter @apps/desktop build",
    "package:desktop": "pnpm --filter @apps/desktop bundle:dmg",
    "build:all": "pnpm build && pnpm build:desktop",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "node scripts/test-pricing-engine.mjs && node scripts/test-printing-package.mjs && node scripts/test-whatsapp-security.mjs",
    "audit:publication": "node scripts/audit-publication.mjs",
    "check": "pnpm audit:publication && pnpm typecheck && pnpm test:unit",
    "palette": "node scripts/palette-server.mjs",
    "desktop": "pnpm --filter @apps/desktop tauri dev"
  },
  "dependencies": {
    "@packages/backend": "workspace:*",
    "@packages/printing": "workspace:*",
    "@packages/shared": "workspace:*",
    "@packages/types": "workspace:*",
    "@supabase/supabase-js": "^2.116.0",
    "@types/leaflet": "^1.9.21",
    "chart.js": "^4.4.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.394.0",
    "next": "15.5.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^18",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "15.5.24",
    "puppeteer-core": "^25.11.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.28",
      "nanoid": "^3.3.18"
    }
  }
}
